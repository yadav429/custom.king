<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CUSTOM KING FF</title>
<style>
body{
background:#080808;
color:white;
font-family:Arial;
text-align:center;
margin:0;
}
header{
background:linear-gradient(90deg,#ff4500,#ffb000);
padding:25px;
color:black;
}
.card{
background:#1c1c1c;
margin:15px;
padding:20px;
border-radius:15px;
border:1px solid orange;
}
h2{color:orange}
input{
width:90%;
padding:14px;
margin:8px;
border-radius:8px;
}
button{
background:orangered;
color:white;
