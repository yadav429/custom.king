<header>
<h1>🔥 CUSTOM KING FF 🔥</h1>
<p>EVERY MATCH EVERY VICTORY</p>
</header>

<div class="card">
<h2>🏆 CUSTOM ROOM</h2>
<h3>ENTRY FEE ₹20</h3>
<h1>WIN ₹200</h1>
<h3>PLAYERS {{count}} / 50</h3>
<p>DAILY MATCH 5 PM</p>
</div>

<div class="card">
<h2>JOIN TOURNAMENT</h2>
<form action="/join" method="POST">
<input name="name" placeholder="Your Name" required>
<input name="uid" placeholder="Free Fire UID" required>
<input name="phone" placeholder="Mobile Number" required>
<br><br>
<button type="submit">JOIN NOW</button>
</form>
</div>

<div class="card">
<h2>REGISTERED PLAYERS</h2>
{% for p in players %}
<p>{{p[1]}} | UID: {{p[2]}}</p>
{% else %}
<p>No Players Yet</p>
{% endfor %}
</div>

</body>
</html>
