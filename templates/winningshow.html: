
<!DOCTYPE html>
<html>
<head><meta name="viewport" content="width=device-width, initial-scale=1"><title>Winning Management</title></head>
<body style="background:#101827;color:white;font-family:Arial;padding:15px">
<h1>🏆 Winning Management</h1>
<form method="POST">
<input name="uid" placeholder="Player UID" required><br><br>
<input name="prize" type="number" min="1" placeholder="Prize Amount" required><br><br>
<input name="match_title" placeholder="Tournament Name"><br><br>
<button type="submit">Add Winner</button>
</form>
<h2>Winner Records</h2>
{% for w in winners %}
<div style="background:#243247;padding:12px;margin:10px">
{{ w['name'] or 'Player' }}<br>
UID: {{ w['player_uid'] }}<br>
Prize: ₹{{ w['prize'] }}<br>
Match: {{ w['match_title'] or 'Tournament' }}
</div>
{% else %}
<p>No Winners Yet</p>
{% endfor %}
<a href="/dashboard">Back to Admin</a>
</body>
</html>
