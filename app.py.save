from flask import Flask, render_template, request, redirect
import sqlite3

app = Flask(__name__)

def database():
    con = sqlite3.connect("game.db")
    con.execute("""
    CREATE TABLE IF NOT EXISTS players(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT,
        uid TEXT UNIQUE,
        phone TEXT
    )
    """)
    con.commit()
    return con

@app.route("/")
def home():
    con = database()
    players = con.execute(
        "SELECT * FROM players"
    ).fetchall()
    con.close()

    return render_template(
        "index.html",
        players=players,
        count=len(players)
    )

@app.route("/join", methods=["POST"])
def join():
    name = request.form.get("name", "").strip()
    uid = request.form.get("uid", "").strip()
    phone = request.form.get("phone", "").strip()

    if not name or not uid or not phone:
        return "Fill all details"

    con = database()

    count = con.execute(
        "SELECT COUNT(*) FROM players"
    ).fetchone()[0]

    if count >= 50:
        con.close()
        return "Room Full!"

    try:
        con.execute(
            "INSERT INTO players(name,uid,phone) VALUES(?,?,?)",
            (name, uid, phone)
        )
        con.commit()
    except sqlite3.IntegrityError:
        con.close()
        return "UID Already Registered!"

    con.close()
    return redirect("/")

if __name__ == "__main__":
    database().close()
    app.run(host="0.0.0.0", port=5000)
from flask import session
from functools import wraps

app.secret_key = "change-this-to-a-long-random-secret"

ADMIN_USER = "admin"
ADMIN_PASSWORD = "KingFF@123"

def admin_required(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        if not session.get("admin"):
            return redirect("/admin-login")
        return func(*args, **kwargs)
    return wrapper

@app.route("/admin-login", methods=["GET", "POST"])
def admin_login():
    if request.method == "POST":
        username = request.form.get("username")
        password = request.form.get("password")

        if username == ADMIN_USER and password == ADMIN_PASSWORD:
            session["admin"] = True
            return redirect("/admin")

        return "Wrong Username or Password"

    return """
    <h2>CUSTOM KING FF ADMIN LOGIN</h2>
    <form method="POST">
    <input name="username" placeholder="Username" required>
    <input name="password" type="password" placeholder="Password" required>
    <button type="submit">LOGIN</button>
    </form>
    """

@app.route("/admin")
@admin_required
def admin():
    con = database()
    players = con.execute("SELECT * FROM players").fetchall()
    con.close()
    return render_template("index.html", players=players, count=len(players))

@app.route("/admin-logout")
def admin_logout():
    session.clear()
    return redirect("/admin-login")

